package ejerciciosApuntes;

import java.util.Arrays;
import java.util.Scanner;

public class ActividadResuelta5_11 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		int input = 0;
		
		System.out.println("Introduce la longitud de la combinación: ");
		System.out.print("  > "); input = sc.nextInt();
		
		int[] arrayPrincipal = new int[input];
		
		for(int i = 0; i < arrayPrincipal.length; i++) {
			arrayPrincipal[i] = (int)(Math.random() * 5) + 1;
		}
		
		int[] arrayUsuario = new int[input];
		
		while(!Arrays.equals(arrayUsuario, arrayPrincipal)) {
			 for(int i = 0; i < arrayUsuario.length; i++) {
				 System.out.println("Introduce el dígito " +(i+1));
				 System.out.print("  > ");
			 }
			
		}
		

	}

}
