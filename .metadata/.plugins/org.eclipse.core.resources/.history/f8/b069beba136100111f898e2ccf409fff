	public static int[] sinRepetidos (int array[]) {
		
		int contador = 0;
		boolean repetido = false;
		for(int i = 0; i < array.length; i++ ) {
			for(int j = 0; j < i; j++) {
				if(array[i] == array[j]) repetido = true;
			}
		}
		if(!repetido) contador++;
		
		int[] arrayNuevo = new int[contador];
		
		
		
		
		
		
		return arrayNuevo;
		
	}

}
