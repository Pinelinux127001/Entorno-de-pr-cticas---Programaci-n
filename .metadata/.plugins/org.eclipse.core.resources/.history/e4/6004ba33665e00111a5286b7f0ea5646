package paquete;

import static org.junit.jupiter.api.Assertions.*;

import org.junit.jupiter.api.Test;

class ProductoTest {

	@Test
	void testProducto() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		String nombre = p1.getNombre();
		double precio = p1.getPrecio();
		int stock = p1.getStock();
		String categoria = p1.getCategoria();
		assertEquals("Manzana", nombre);
		assertEquals(5, precio);
		assertEquals(10, stock);
		assertEquals("Fruta", categoria);
	}

	@Test
	void testGetNombre() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		String nombre = p1.getNombre();
		assertEquals("Manzana", nombre);
	}

	@Test
	void testSetNombre() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		p1.setNombre("Pera");
		String nombre = p1.getNombre();
		assertEquals("Pera", nombre);
	}

	@Test
	void testGetPrecio() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		double precio = p1.getPrecio();
		assertEquals(5, precio);
	}

	@Test
	void testSetPrecio() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		p1.setPrecio(6);	
		double precio = p1.getPrecio();
		assertEquals(6, precio);
	}

	@Test
	void testGetStock() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		int stock = p1.getStock();
		assertEquals(10, stock);
	}

	@Test
	void testSetStock() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		p1.setStock(11);	
		int stock = p1.getStock();
		assertEquals(11, stock);
	}

	@Test
	void testGetCategoria() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		String categoria = p1.getCategoria();
		assertEquals("Fruta", categoria);
	}

	@Test
	void testSetCategoria() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		p1.setCategoria("Verduras");
		String categoria = p1.getCategoria();
		assertEquals("Verduras", categoria);
	}

	@Test
	void testIsActivo() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		Producto p2 = new Producto("Pera", 5, 10, "Fruta");
		p2.setActivo(false);
		assertTrue(p1.isActivo());
		assertFalse(p2.isActivo());
	}

	@Test
	void testSetActivo() {
		Producto p1 = new Producto("Manzana", 5, 10, "Fruta");
		Producto p2 = new Producto("Pera", 5, 10, "Fruta");
		p1.setActivo(false);
		p2.setActivo(false);
		p2.setActivo(true);
		assertFalse(p1.isActivo());
		assertTrue(p2.isActivo());
	}

	@Test
	void testObtenerCodigoProducto() {
		Producto p1 = new Producto("", 5, 10, "Fruta");
		Producto p2 = new Producto(null, 5, 10, "Fruta");
		Producto p3 = new Producto("Pera", 5, 10, "Fruta");
		String codigo = p3.obtenerCodigoProducto();
		assertNull(p1.obtenerCodigoProducto());
		assertNull(p2.obtenerCodigoProducto());
		assertEquals("PER-10", codigo);
	}

	@Test
	void testHayStock() {
		Producto p1 = new Producto("Pera", 5, 10, "Fruta");
		Producto p2 = new Producto("Pera", 5, 0, "Fruta");
		assertTrue(p1.hayStock());
		assertFalse(p2.hayStock());
	}

	@Test
	void testCalcularPrecioConIVA() {
		Producto p1 = new Producto("Pera", 5, 10, "Fruta");
		double precio = p1.calcularPrecioConIVA();
		assertEquals((5*1.21), precio);
	}

