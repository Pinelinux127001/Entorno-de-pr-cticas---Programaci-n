public class ActividadPropuesta5_5 {

	public static void main(String[] args) {
		
		int[] arrayOriginal = {1, 2, 3, 4, 6, 7, 8, 9, 10};
		int valorAIntroducir = 5;
		

	}
	
	public static int[] introducirValor(int valorAIntroducir, int[] arrayOriginal){
		int inicio = 0;
		int fin = arrayOriginal.length - 1;
		int medio;

		while(inicio <= fin) {
		    medio = (inicio + fin) / 2;
		    if(arrayOriginal[medio] == valorAIntroducir) {
		        break;
		    } else if(valorAIntroducir > arrayOriginal[medio]) {
		        inicio = medio + 1;
		    } else {
		        fin = medio - 1;
		    }
		}
		int indiceInsercion = inicio;
	}

}
